# Copy the required values into your hosting provider's environment settings.
# Never commit actual secrets to Git or include them in a ZIP shared publicly.
GEMINI_API_KEY=
APP_TIMEZONE=Africa/Cairo

# Persistent storage: configure a persistent disk on the host and point these paths to it.
# Example for a mounted persistent disk:
# STESSERACT_DB_FILE=/data/stesseract_core.db
# GENERATED_VIDEO_DIR=/data/generated_videos
# STUDY_UPLOAD_DIR=/data/study_uploads
# EXAM_SOURCE_DIR=/data/exam_sources

# Optional isolated Piston-compatible code runner. Code submitted to this endpoint is sent to that service.
# CODE_RUNNER_URL=https://your-trusted-runner.example/api/v2/execute

# Optional security/legacy migration settings; review before changing existing-account behavior.
# ALLOW_PASSWORDLESS_LEGACY=false
# COOKIE_SECURE=true
